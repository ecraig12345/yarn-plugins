{
  "name": "yarn-plugins",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "yarn tsc -b && node scripts/build.ts --all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "workspaces": [
    "plugins/*"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.0.0",
    "@yarnpkg/cli": "^4.14.1",
    "esbuild-wasm": "^0.28.1",
    "nano-spawn": "^2.1.0",
    "prettier": "^3.8.3",
    "semver": "^7.7.4",
    "syncpack": "^15.0.0",
    "typescript": "~7.0.0",
    "vitest": "^4.1.5",
    "workspace-tools": "^0.42.0"
  },
  "resolutions": {
    "glob@npm:^10.2.2": "^13.0.0",
    "minimatch@npm:^9.0.5": "^10.2.2"
  },
  "rationale": {
    "resolutions": {
      "glob@npm:^10.2.2": "Fix security issue (used API is compatible)",
      "minimatch@npm:^9.0.5": "Remove insecure dep (not actually used)"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
