{
  "name": "yarn-plugins",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "yarn tsc -b && node scripts/build.js --all",
    "clean": "node scripts/clean.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "workspaces": [
    "plugins/*"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/semver": "^7.0.0",
    "@yarnpkg/builder": "^4.2.3",
    "nano-spawn": "^2.1.0",
    "prettier": "^3.8.3",
    "semver": "^7.7.4",
    "syncpack": "^15.0.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.5",
    "workspace-tools": "^0.41.7"
  },
  "resolutions": {
    "glob@npm:^10.2.2": "^13.0.0",
    "minimatch@npm:^9.0.5": "^10.2.2",
    "tar@npm:^6.0.5": "^7.5.9"
  },
  "rationale": {
    "resolutions": {
      "glob@npm:^10.2.2": "Fix security issue (used API is compatible)",
      "minimatch@npm:^9.0.5": "Remove insecure dep (not actually used)",
      "tar@npm:^6.0.5": "Fix security issue (API is compatible)"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
